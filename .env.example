# Copy this file to .env and fill in ANY ONE key. Nib uses the first one it finds, in this order.
# NOVA emails every team an OpenRouter key at the start of hacking.
OPENROUTER_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Optional: force one provider (openrouter, gemini, claude or openai) when several keys are set.
# NIB_PROVIDER=openrouter

# Optional: override the model. For OpenRouter, any id from openrouter.ai/models that takes images.
# OPENROUTER_MODEL=google/gemini-3.8-flash
# GEMINI_MODEL=gemini-3.8-flash
# CLAUDE_MODEL=claude-opus-5-5
# OPENAI_MODEL=gpt-5.2
