# Copy this file to .env and fill in ANY ONE key. Nib uses the first one it finds,
# in this order: Gemini, Claude, OpenAI.
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Optional: force one provider (gemini, claude or openai) when several keys are set.
# NIB_PROVIDER=gemini

# Optional: override the model per provider.
# GEMINI_MODEL=gemini-3.8-flash
# CLAUDE_MODEL=claude-opus-5-5
# OPENAI_MODEL=gpt-5.2
